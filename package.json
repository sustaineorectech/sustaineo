{
  "name": "sustaineo",
  "version": "1.0.0",
  "private": true,
  "description": "Sustaineo Recycling Technologies - Static SPA",
  "scripts": {
    "minify:css": "npx cleancss -o style.min.css style.css",
    "minify:js": "npx terser script.js -o script.min.js -c -m",
    "minify:html": "npx html-minifier --collapse-whitespace --remove-comments --remove-optional-tags --remove-redundant-attributes --remove-script-type-attributes --remove-style-link-type-attributes --use-short-doctype -o index.min.html index.html",
    "build": "npm run minify:css && npm run minify:js && npm run minify:html",
    "build:prod": "npm run build && echo 'Build complete. Deploy index.min.html, style.min.css, script.min.js'"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.0",
    "terser": "^5.26.0",
    "html-minifier": "^4.0.0"
  }
}
